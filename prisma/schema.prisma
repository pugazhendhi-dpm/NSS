// NSS Platform - Prisma Schema for MySQL
// Migrated from Supabase (PostgreSQL) to MySQL 8.0

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// AUTHORIZED USERS (Login access control)
// ============================================
model AuthorizedUser {
  id        String   @id @default(uuid()) @db.Char(36)
  email     String   @unique @db.VarChar(255)
  name      String   @db.VarChar(255)
  role      String   @db.VarChar(20) // 'admin' | 'supersenior'
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([email])
  @@index([role])
  @@map("authorized_users")
}

// ============================================
// ACTIVITIES
// ============================================
model Activity {
  id          String   @id @default(uuid()) @db.Char(36)
  title       String   @db.VarChar(500)
  description String?  @db.Text
  category    String   @db.VarChar(50) // 'Regular Activities' | 'Special Camps'
  date        DateTime @db.Date
  location    String?  @db.VarChar(500)
  participants Int     @default(0)
  imageUrl    String?  @map("image_url") @db.Text
  documentUrl String?  @map("document_url") @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String?  @map("created_by") @db.VarChar(255)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([date(sort: Desc)])
  @@index([category])
  @@map("activities")
}

// ============================================
// GALLERY
// ============================================
model Gallery {
  id          String   @id @default(uuid()) @db.Char(36)
  title       String   @db.VarChar(500)
  description String?  @db.Text
  imagePath   String   @map("image_path") @db.Text
  category    String?  @db.VarChar(100)
  uploadedAt  DateTime @default(now()) @map("uploaded_at")
  uploadedBy  String?  @map("uploaded_by") @db.VarChar(255)
  fileSize    Int?     @map("file_size")
  mimeType    String?  @map("mime_type") @db.VarChar(100)

  @@index([uploadedAt(sort: Desc)])
  @@map("gallery")
}

// ============================================
// STATISTICS
// ============================================
model Statistics {
  id                 String   @id @default(uuid()) @db.Char(36)
  volunteersEnrolled Int      @default(0) @map("volunteers_enrolled")
  hoursOfService     Int      @default(0) @map("hours_of_service")
  bloodUnitsDonated  Int      @default(0) @map("blood_units_donated")
  villagesAdopted    Int      @default(0) @map("villages_adopted")
  lastUpdated        DateTime @default(now()) @map("last_updated")
  lastUpdatedBy      String?  @map("last_updated_by") @db.VarChar(255)

  @@map("statistics")
}

// ============================================
// UPDATES (Announcements / Marquee)
// ============================================
model Update {
  id        String   @id @default(uuid()) @db.Char(36)
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by") @db.VarChar(255)

  @@index([createdAt(sort: Desc)])
  @@map("updates")
}

// ============================================
// VOLUNTEERS
// ============================================
model Volunteer {
  id         String   @id @default(uuid()) @db.Char(36)
  name       String   @db.VarChar(255)
  email      String   @unique @db.VarChar(255)
  rollNumber String   @unique @map("roll_number") @db.VarChar(50)
  department String?  @db.VarChar(255)
  year       Int?
  phone      String?  @db.VarChar(20)
  bloodGroup String?  @map("blood_group") @db.VarChar(50)
  role       String   @default("volunteer") @db.VarChar(20) // 'volunteer' | 'supersenior' | 'admin'
  status     String   @default("pending") @db.VarChar(20)   // 'pending' | 'approved' | 'rejected'
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  attendanceRecords AttendanceRecord[]

  @@index([email])
  @@index([status])
  @@map("volunteers")
}

// ============================================
// BLOOD DONORS
// ============================================
model BloodDonor {
  id                       String    @id @default(uuid()) @db.Char(36)
  name                     String    @db.VarChar(255)
  bloodGroup               String    @map("blood_group") @db.VarChar(50) // 'A+','A-','B+','B-','AB+','AB-','O+','O-'
  phone                    String    @db.VarChar(20)
  email                    String?   @db.VarChar(255)
  age                      Int?
  gender                   String?   @db.VarChar(10) // 'Male' | 'Female' | 'Other'
  address                  String?   @db.Text
  lastDonationDate         DateTime? @map("last_donation_date") @db.Date
  isAvailable              Boolean   @default(true) @map("is_available")
  createdAt                DateTime  @default(now()) @map("created_at")
  // Extended student fields
  rollNumber               String?   @map("roll_number") @db.VarChar(50)
  department               String?   @db.VarChar(255)
  year                     String?   @db.VarChar(10)
  section                  String?   @db.VarChar(10)
  district                 String?   @db.VarChar(100)
  hometown                 String?   @db.VarChar(100)
  alternatePhone           String?   @map("alternate_phone") @db.VarChar(20)
  bloodDonationWillingness String?   @map("blood_donation_willingness") @db.VarChar(20)
  residentialStatus        String?   @map("residential_status") @db.VarChar(20)
  batch                    String?   @db.VarChar(20)
  // Geolocation fields
  latitude                 Decimal?  @db.Decimal(10, 8)
  longitude                Decimal?  @db.Decimal(11, 8)
  geocodedAt               DateTime? @map("geocoded_at")
  geocodeSource            String?   @default("nominatim") @map("geocode_source") @db.VarChar(50)

  @@index([bloodGroup])
  @@index([isAvailable])
  @@index([rollNumber])
  @@index([department])
  @@map("blood_donors")
}

// ============================================
// BLOOD DONATION YEARS
// ============================================
model BloodDonationYear {
  id           String   @id @default(uuid()) @db.Char(36)
  academicYear String   @map("academic_year") @db.VarChar(20) // e.g. '2023-24'
  eventName    String   @map("event_name") @db.VarChar(500)
  donationDate String   @map("donation_date") @db.VarChar(20) // ISO date string
  unitsDonated Int      @map("units_donated")
  donorsCount  Int      @map("donors_count")
  createdBy    String?  @map("created_by") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([donationDate(sort: Desc)])
  @@map("blood_donation_years")
}

// ============================================
// FEATURED VOLUNTEERS
// ============================================
model FeaturedVolunteer {
  id         String   @id @default(uuid()) @db.Char(36)
  name       String   @db.VarChar(255)
  department String   @db.VarChar(255)
  phone      String   @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("featured_volunteers")
}

// ============================================
// SLIDER EVENTS
// ============================================
model SliderEvent {
  id         String   @id @default(uuid()) @db.Char(36)
  title      String   @db.VarChar(500)
  subtitle   String?  @db.VarChar(500)
  imagePath  String   @map("image_path") @db.Text
  orderIndex Int      @default(0) @map("order_index")
  createdAt  DateTime @default(now()) @map("created_at")
  createdBy  String?  @map("created_by") @db.VarChar(255)

  @@index([orderIndex])
  @@map("slider_events")
}

// ============================================
// ATTENDANCE RECORDS
// ============================================
model AttendanceRecord {
  id                   String   @id @default(uuid()) @db.Char(36)
  volunteerId          String   @map("volunteer_id") @db.Char(36)
  volunteerName        String   @map("volunteer_name") @db.VarChar(255)
  volunteerRollNumber  String   @map("volunteer_roll_number") @db.VarChar(50)
  activityName         String   @map("activity_name") @db.VarChar(500)
  activityDate         DateTime @map("activity_date") @db.Date
  status               String   @db.VarChar(10) // 'present' | 'absent' | 'late'
  markedBy             String   @map("marked_by") @db.VarChar(255)
  markedById           String?  @map("marked_by_id") @db.Char(36)
  markedAt             DateTime @default(now()) @map("marked_at")
  notes                String?  @db.Text
  createdAt            DateTime @default(now()) @map("created_at")

  // Relations
  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@index([volunteerId])
  @@index([activityDate(sort: Desc)])
  @@index([activityName])
  @@index([status])
  @@index([markedAt(sort: Desc)])
  @@index([volunteerId, activityDate(sort: Desc)])
  @@map("attendance_records")
}

// ============================================
// SYSTEM SETTINGS
// ============================================
model SystemSetting {
  id               String  @id @default("global") @db.VarChar(50)
  activeDonorBatch String? @map("active_donor_batch") @db.VarChar(20)

  @@map("system_settings")
}
